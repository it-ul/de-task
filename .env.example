# --- Postgres (docker) ------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Генерация данных ---------------------------------------------------------
# Объём синтетики для первого запуска (записей в prices)
N_PRICES=300000

# --- Подключение --------------------------------------------------------------
# В Docker хосты переопределяются на имя сервиса pg17 (см. docker-compose.yml).
# Локально (без Docker) можно оставить дефолты из etl/config.py (host=pg17)
# или явно указать:
# DWH_HOST=localhost
# SOURCE_HOST=localhost
# DWH_PORT=5432
# DWH_USER=postgres
# DWH_PASSWORD=postgres
# Явные DSN имеют приоритет над сборкой из частей:
# SOURCE_DSN=postgresql://postgres:postgres@localhost:5432/deals_bigdata
# DWH_DSN=postgresql://postgres:postgres@localhost:5432/dwh

# --- Параметры ETL -------------------------------------------------------------
# ETL_BATCH_SIZE=20000
# ETL_ID_CHUNK=50000
